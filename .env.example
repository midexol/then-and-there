# ---- server (Render/Railway/Fly). Never commit real values. ----
QLOO_API_KEY=
# Hackathon keys only work on this host (api.qloo.com returns 401). Both must be set, to the same URL.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
# Optional: any OpenAI-compatible endpoint (Groq, Gemini, OpenRouter, OpenAI…). Without it, built-in questions are used.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
ALLOWED_ORIGIN=http://localhost:3000
PORT=8787
# QLOO_MODE=mock   # force demo fixtures even with a key

# ---- web (Vercel) ----
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3000
